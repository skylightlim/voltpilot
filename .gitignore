# dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo

# deploy artifacts
.vercel/
.wrangler/

# secrets — NEVER COMMIT
.env
.env.*
# templates must ship: .env.*.example matches .env.* above
!.env.example
!.env.local.example
!*.example

# databases / generated data
*.db
*.sqlite
*.sqlite3

# test + tooling
test-results/
playwright-report/
.pytest_cache/
.impeccable/

# os
.DS_Store
*.log

# Written by scripts/daily_update.py on every run — runtime state, not source.
# Absent in a fresh container, which is exactly why /health/data reports red
# until the first refresh has happened.
data/refresh-state.json

# Superseded render frames; the shipping 3D asset is
# frontend/public/models/showroom-car.glb
data/emas5_3d/

# scratch build dirs from NEXT_DIST_DIR
frontend/.next-*

# scratch databases from alembic runs
backend/*_test.db
backend/_scratch.db
