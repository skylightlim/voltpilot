# dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo

# deploy artifacts
.vercel/
.wrangler/

# secrets — NEVER COMMIT
.env
.env.*
# templates must ship: .env.*.example matches .env.* above
!.env.example
!.env.local.example
!*.example

# databases / generated data
*.db
*.sqlite
*.sqlite3

# test + tooling
test-results/
playwright-report/
.pytest_cache/
.impeccable/

# os
.DS_Store
*.log

# Written by scripts/daily_update.py on every run. Ignored so that a local run,
# whose output carries the developer's paths, is never committed by accident.
# daily-refresh.yml force-adds the runner's copy, which is how /health/data in
# the deployed bundle learns when the last refresh ran.
data/refresh-state.json

# Superseded render frames; the shipping 3D asset is
# frontend/public/models/showroom-car.glb
data/emas5_3d/

# scratch build dirs from NEXT_DIST_DIR
frontend/.next-*

# scratch databases from alembic runs
backend/*_test.db
backend/_scratch.db

# Generated by backend/vercel-build.sh, which copies the root data/ and
# scripts/ into backend/ for a Vercel project rooted there.
backend/data/
backend/scripts/

# Database backups from scripts/used_market/migrate_strict.py (7-8 MB binaries)
*.bak-*

# SQLite sidecars from read-only connections
*.db-shm
*.db-wal
