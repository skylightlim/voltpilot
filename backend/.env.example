# Copy to .env and fill in
DATABASE_URL=sqlite+aiosqlite:///./dev.db
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=gemini-3.7-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ai-transport.local
SMTP_TLS=false
ENABLE_EMAIL=true
DATA_DIR=../data

# Shared secret for POST /admin/refresh (the daily data refresh the Cloudflare
# cron trigger calls). Generate with: openssl rand -hex 24
# Leave blank to disable the endpoint entirely.
ADMIN_TOKEN=

# Deployment environment. Anything other than "production" also allows the
# localhost CORS origins used in development.
ENV=development

# The deployed frontend's origin, used for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated extra CORS origins, e.g. a preview deployment, so adding one
# does not need a code change.
EXTRA_CORS_ORIGINS=

# Optional overrides for the JPJ EV reference tables consumed by
# scripts/used_market/compute_road_tax.py.
# EV_TAX_PATH=
# EV_BRACKETS_PATH=

# Per-client requests per minute. /score runs the whole engine and /chat calls
# Gemini, so both are held far tighter than reads.
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_SCORE=10
RATE_LIMIT_CHAT=20
RATE_LIMIT_REPORT=5
RATE_LIMIT_TOKENS=10
