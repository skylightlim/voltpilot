# Copy to .env and fill in
DATABASE_URL=sqlite+aiosqlite:///./dev.db
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=gemini-3.7-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ai-transport.local
ENABLE_EMAIL=true
DATA_DIR=../data