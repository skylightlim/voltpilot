# Frontend environment. Copy to .env.local for local development.
#
# Where the browser's /api/proxy/* rewrite forwards to. This is baked in at
# BUILD time (see next.config.ts), so it must be set before `next build` — not
# only at runtime. In CI it comes from the BACKEND_URL repository variable.
BACKEND_URL=http://127.0.0.1:8000

# Only needed if something must reach the backend directly rather than through
# the proxy. Normally leave unset: routing through /api/proxy keeps the backend
# URL out of the client bundle and sidesteps CORS.
# NEXT_PUBLIC_BACKEND_URL=

# Canonical public URL, used for Open Graph image and canonical links.
# Optional on Vercel, which supplies VERCEL_PROJECT_PRODUCTION_URL at build
# time. Set it only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://voltpilot.vercel.app
